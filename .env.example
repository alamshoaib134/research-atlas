# Required for AI features (Topic Analysis, Paper Categorization, RAG Q&A)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: NewsData API key for topic news
# Get a free key at https://newsdata.io
NEWSDATA_API_KEY=pub_your_key_here

